{
  "name": "wechat-article-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx server/index.ts",
    "server": "tsx server/index.ts",
    "mcp": "tsx server/mcp.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx server/index.ts",
    "export": "tsx tools/export-article.ts",
    "screenshot": "tsx tools/render-preview.ts",
    "import:weekly": "tsx tools/import-weekly.ts",
    "check:public": "node tools/check-public.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "description": "Local-first, component-based WeChat article editor with HTML export and MCP tools.",
  "license": "MIT",
  "author": "lmy414",
  "repository": {
    "type": "git",
    "url": "https://github.com/lmy414/wechat-article-studio.git"
  },
  "homepage": "https://github.com/lmy414/wechat-article-studio#readme",
  "engines": {
    "node": ">=22.12"
  }
}
